DATABASE_URL="postgresql://paper:paper@localhost:5432/paper_viewer"
DIRECT_URL="postgresql://paper:paper@localhost:5432/paper_viewer"
AUTH_SECRET="replace-with-a-32-byte-random-secret"
APP_URL="http://localhost:3000"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="paper-pdfs"
S3_FORCE_PATH_STYLE="true"
# Vercel Blob 快照存储（PDF 固化，标注锚点不随 arXiv 更新漂移）；本地留空即可
BLOB_READ_WRITE_TOKEN=""
MAX_PDF_UPLOAD_MB="50"
INGEST_API_KEY="replace-with-a-random-api-key"
# Vercel Cron 鉴权（部署必配，≥16 字符随机串）
CRON_SECRET=""
RESEND_API_KEY="your-resend-api-key"
# 顶会目录数据源（GitHub repo 里的 raw JSON 链接）。占位：拿到 repo 后填
# https://raw.githubusercontent.com/<owner>/<repo>/main/papers.json 这类地址
CONFERENCE_SOURCE_URL=""
# LLM（可选兜底）：推荐部署后在设置页（Settings → LLM）配置，存数据库、随时可换。
# 这三项仅在数据库无配置时作为兜底；不填 LLM_API_KEY 则必须用设置页配置。
LLM_API_KEY=""
LLM_BASE_URL="https://api.moonshot.ai/v1"
LLM_MODEL="kimi-k2.5"
